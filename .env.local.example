# SafeBARS local secrets — COPY this file to `.env.local` and fill in real values.
# `.env.local` is git-ignored (see .gitignore line 2 `.env.*`); never commit it.
# `.env.local.example` IS tracked (force-included) so collaborators know the keys needed.

# --- Multi-model evaluation (modules/multi_model_eval.py) ---
# Aliyun Bailian (DashScope) key. Also accepted via DASHSCOPE_API_KEY / ALIYUN_API_KEY.
BAILIAN_API_KEY=sk-your-real-bailian-key-here

# Optional: which Qwen variant the engine uses by default (overridden per-variant by the script).
# BAILIAN_MODEL=qwen-plus

# --- Other providers the engine can use (optional) ---
# ZHI_KEY=your-zhipu-key
# TENCENT_API_KEY=your-hunyuan-key
# XFYUN_MAAS_API_KEY=your-xfyun-key
